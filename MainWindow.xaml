<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gallery.Controls"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            <KeyboardAccelerator Key="Left" Invoked="OnLeftInvoked" />
            <KeyboardAccelerator Key="Right" Invoked="OnRightInvoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏：48 高，右侧留出系统按钮 138
              照搬 photos 的 CollectionTitleBar 列结构：
              [AppIconAndName Auto] [SearchBox *] [CommandBar Auto MinWidth=110] [RightPadding 138]  -->
        <Grid x:Name="TitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="110" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon FontSize="16" Glyph="&#xE91B;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="Gallery" />
            </StackPanel>

            <controls:SearchInputBox
                x:Name="SearchBox"
                PreventAutomaticFocus="True"
                Grid.Column="1"
                MinWidth="160"
                MaxWidth="718"
                Margin="24,0,24,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                CornerRadius="4"
                PlaceholderText="在图库中搜索"
                TextChanged="SearchBox_TextChanged" />

            <!--  标题栏按钮：设置（E713 齿轮）。
                  照搬 photos：SettingsButtonWidth=40、CommandBar 右对齐、
                  按钮在系统按钮左侧（右padding列 138 即系统按钮区）。  -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">

            <!--  待审核文字入口，与标题栏按钮共用垂直中心线。  -->
            <Button
                x:Name="ReviewChipButton"
                Height="28"
                Margin="0,0,4,0"
                Padding="10,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="待审核"
                Click="ReviewChip_Click"
                CornerRadius="14"
                ToolTipService.ToolTip="打开待审核"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon VerticalAlignment="Center" FontSize="12" Glyph="&#xE8B5;" />
                    <TextBlock
                        x:Name="ReviewChipText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="待审核" />
                </StackPanel>
            </Button>

            <controls:CustomCommandBar
                x:Name="TitleCommandBar"
                Margin="12,0,12,0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                ClosedDisplayMode="Compact"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="False"
                OverflowButtonVisibility="Collapsed">
                <AppBarButton
                    x:Name="SettingsButton"
                    Width="40"
                    Height="48"
                    AutomationProperties.Name="设置"
                    Click="SettingsButton_Click"
                    Label="设置"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="设置">
                    <AppBarButton.Icon>
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </controls:CustomCommandBar>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            Background="Transparent"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="320"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <!--  照搬 photos 的 MainGalleryNavigationViewItem：
                      按钮在图库行右列（36×36，margin 0,0,-10,0，E8F4），
                      图库项右键 =「添加文件夹」（ECC8）  -->
                <NavigationViewItem Tag="all" HorizontalContentAlignment="Stretch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </NavigationViewItem.Icon>
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="图库" />
                        <Button
                            x:Name="AddFolderButton"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="0,0,-20,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AddFolderButton_Click"
                            ToolTipService.ToolTip="添加文件夹">
                            <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                        </Button>
                    </Grid>
                    <NavigationViewItem.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="AddFolderButton_Click" Text="添加文件夹">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xECC8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </NavigationViewItem.ContextFlyout>
                </NavigationViewItem>
                <NavigationViewItem Content="资料库" Tag="catalog">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ReviewNavItem" Tag="review" HorizontalContentAlignment="Stretch">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8B5;" />
                </NavigationViewItem.Icon>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ReviewNavText"
                        VerticalAlignment="Center"
                        Text="待审核" />
                    <Button
                        x:Name="ImportToReviewButton"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="0,0,-20,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ImportToReviewButton_Click"
                        ToolTipService.ToolTip="导入文件夹到待审核">
                        <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                    </Button>
                </Grid>
            </NavigationViewItem>
            <NavigationViewItem Content="收藏夹" Tag="fav">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!--  照搬 photos CollectionRootPage：NavigationView.Content = MainPanel
                  {Gripper 贴左缘（即 pane 右缘）, Frame 在 Gripper 右侧 16px}  -->
            <Grid x:Name="MainPanel">
                <controls:PaneResizer x:Name="Gripper" />
                <Grid
                    x:Name="ContentHost"
                    IsTabStop="True"
                    UseSystemFocusVisuals="False"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Stretch" />
            </Grid>
        </NavigationView>

        <controls:PreviewOverlay x:Name="Preview" Grid.RowSpan="2" />

        <!--  通知浮层：照搬 galleryold toast.py（右下 348×82，最多 4 条）  -->
        <controls:ToastHost x:Name="Toasts" Grid.RowSpan="2" />
    </Grid>
</Window>
