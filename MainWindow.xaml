<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gallery.Controls"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            <KeyboardAccelerator Key="Left" Invoked="OnLeftInvoked" />
            <KeyboardAccelerator Key="Right" Invoked="OnRightInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏：48 高，右侧留出系统按钮 138
              照搬 photos 的 CollectionTitleBar 列结构：
              [AppIconAndName Auto] [SearchBox *] [CommandBar Auto MinWidth=110] [RightPadding 138]  -->
        <Grid x:Name="TitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="110" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon FontSize="16" Glyph="&#xE91B;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="Gallery" />
            </StackPanel>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                MinWidth="160"
                MaxWidth="718"
                Margin="24,0,24,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                CornerRadius="4"
                PlaceholderText="在图库中搜索"
                TextChanged="SearchBox_TextChanged" />

            <!--  标题栏按钮：设置（E713 齿轮）。
                  照搬 photos：SettingsButtonWidth=40、CommandBar 右对齐、
                  按钮在系统按钮左侧（右padding列 138 即系统按钮区）。  -->
            <CommandBar
                x:Name="TitleCommandBar"
                Grid.Column="2"
                Margin="12,0,12,0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                ClosedDisplayMode="Compact"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="False"
                OverflowButtonVisibility="Collapsed">
                <AppBarButton
                    x:Name="SettingsButton"
                    Width="40"
                    Height="48"
                    AutomationProperties.Name="设置"
                    Click="SettingsButton_Click"
                    Label="设置"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="设置">
                    <AppBarButton.Icon>
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            Background="Transparent"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="320"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <!--  照搬 photos 的 MainGalleryNavigationViewItem：
                      按钮在图库行右列（36×36，margin 0,0,-10,0，E8F4），
                      图库项右键 =「添加文件夹」（ECC8）  -->
                <NavigationViewItem Tag="all" HorizontalContentAlignment="Stretch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </NavigationViewItem.Icon>
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="图库" />
                        <Button
                            x:Name="AddFolderButton"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="0,0,-20,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AddFolderButton_Click"
                            ToolTipService.ToolTip="添加文件夹">
                            <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                        </Button>
                    </Grid>
                    <NavigationViewItem.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="AddFolderButton_Click" Text="添加文件夹">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xECC8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </NavigationViewItem.ContextFlyout>
                </NavigationViewItem>
                <NavigationViewItem Content="收藏夹" Tag="fav">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="ContentHost" />
        </NavigationView>

        <!--  照搬 photos 的 Gripper 视觉（LeftNavGripperStyle：E784 字形、透明底、宽 16）
              + 交互语义（拖动改 OpenPaneLength，范围 galleryold 180–500，拖完记忆）。
              photos 用 ctc:PropertySizer，但其模板内 Thumb 不冒泡 ManipulationDelta，
              故这里用 Grid 自实现同样的交互。  -->
        <Grid
            x:Name="Gripper"
            Grid.RowSpan="2"
            Width="16"
            Margin="272,48,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="Transparent">
            <FontIcon
                FontSize="12"
                Glyph="&#xE784;"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
        <controls:PreviewOverlay x:Name="Preview" Grid.RowSpan="2" />

        <!--  通知浮层：照搬 galleryold toast.py（右下 348×82，最多 4 条）  -->
        <controls:ToastHost x:Name="Toasts" Grid.RowSpan="2" />
    </Grid>
</Window>
