<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Gallery.Version.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Gallery</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <PathMap>$(MSBuildProjectDirectory)=/_/Gallery,$(NuGetPackageRoot)=/_/Packages/</PathMap>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标：tools/make_icon.py 从标题栏字形 E91B 生成 -->
    <ApplicationIcon>assets\Gallery.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Microsoft_AI_DirectML_SkipDebugLayerCopy Condition="'$(Configuration)' == 'Release'">true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 运行时资料包不作为源码或项目资源参与构建。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);models\**;archive\**;.staging\**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- 2026-11-13：用户明确要求保留 ImageSharp 3.1.5 并屏蔽这些已知告警。风险见 DISTRIBUTION.md；不屏蔽其他漏洞。 -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2cmq-823j-5qj8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rxmq-m78w-7wmc" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>
  <PropertyGroup Condition="'$(EnableDevelopmentVerification)' == 'true'">
    <DefineConstants>$(DefineConstants);GALLERY_DEVELOPMENT</DefineConstants>
  </PropertyGroup>
  <Target Name="RejectDevelopmentRelease" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release' and '$(EnableDevelopmentVerification)' == 'true'">
    <Error Text="Development verification cannot be included in a Release build." />
  </Target>
  <ItemGroup>
    <Compile Remove="Development\**;Updater\**" />
    <Compile Include="Development\**\*.cs" Condition="'$(EnableDevelopmentVerification)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- DirectML 版同时包含 CPU 执行器：一个包支持「自动 / CPU / GPU」三档，GPU 不可用时在同一进程内回退 CPU。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Assets\**\*;assets\**\*" />
    <None Remove="assets\**\*" />
    <Content Include="assets\PhotoEditor\**\*" Exclude="assets\PhotoEditor\ORIGIN.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\Gallery.ico;assets\Common\PhotosIcons.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="distribution-kind.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="USER_GUIDE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="extension\*.js;extension\*.html;extension\*.css;extension\manifest.json;extension\icons\*.png;extension\README.md" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Services\LibrarySchema.sql" LogicalName="Gallery.Services.LibrarySchema.sql" />
    <EmbeddedResource Include="Services\NaturalSortUnicode.txt" LogicalName="Gallery.Services.NaturalSortUnicode.txt" />
    <EmbeddedResource Include="Controls\Review\Spray.cur" LogicalName="Gallery.Controls.Review.Spray.cur" />
    <EmbeddedResource Include="Controls\Review\ReviewCarousel.html" LogicalName="Gallery.Controls.Review.ReviewCarousel.html" />
  </ItemGroup>
</Project>
