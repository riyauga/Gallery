<?xml version="1.0" encoding="utf-8"?>
<!--
    设置页。
    照搬 photos 的 PhotosManager/Views/Pages/SettingsPage.xaml：
    - 页头 SimplePageHeader：margin 32,28,48,26 / 图标 E713 FontSize 20 / 标题 FontSize 24
    - 内容 ScrollViewer padding 32,0,48,0 / StackPanel MaxWidth 958 / Spacing 3
    - 副标题「个性化」margin 1,24,0,6，BodyStrongTextBlockStyle
    - SettingsCard：Header「应用主题」/ Description「浅色、深色或跟随 Windows」/ HeaderIcon E790 FontSize 16
    - 右侧 DropDownButton + MenuFlyout 三项（浅色 / 深色 / 跟随 Windows），RadioMenuFlyoutItem 互斥
-->
<UserControl
    x:Class="Gallery.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Gallery.Controls"
    Background="Transparent">

    <Grid x:Name="SettingsRoot" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页头：SimplePageHeader（图标 + 标题），margin 32,28,48,26  -->
        <Grid Grid.Row="0" Margin="32,28,48,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="20"
                Glyph="&#xE713;" />
            <TextBlock
                Grid.Column="1"
                MinWidth="124"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="1"
                FontSize="24"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="设置"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="32,0,48,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsHorizontalRailEnabled="False"
            IsVerticalRailEnabled="True"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled">
            <Grid>
                <StackPanel
                    MaxWidth="958"
                    Margin="0,0,0,64"
                    Orientation="Vertical"
                    Spacing="3">
                    <StackPanel.ChildrenTransitions>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </StackPanel.ChildrenTransitions>

                    <!--  个性化  -->
                    <TextBlock
                        Margin="1,24,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="个性化" />

                    <ctc:SettingsCard
                        Description="浅色、深色或跟随 Windows"
                        Header="应用主题">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE790;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <DropDownButton x:Name="ThemeDropdown" Content="深色">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <RadioMenuFlyoutItem
                                        x:Name="ThemeLightItem"
                                        Click="ThemeLightItem_Click"
                                        GroupName="AppTheme"
                                        Text="浅色" />
                                    <RadioMenuFlyoutItem
                                        x:Name="ThemeDarkItem"
                                        Click="ThemeDarkItem_Click"
                                        GroupName="AppTheme"
                                        Text="深色" />
                                    <RadioMenuFlyoutItem
                                        x:Name="ThemeDefaultItem"
                                        Click="ThemeDefaultItem_Click"
                                        GroupName="AppTheme"
                                        Text="跟随 Windows" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </ctc:SettingsCard>

                    <!--  浏览器插件  -->
                    <TextBlock
                        Margin="1,24,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="浏览器插件" />

                    <ctc:SettingsCard
                        x:Name="BridgeStatusCard"
                        Description="浏览器插件是否已连接"
                        Header="桥接状态">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE774;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock VerticalAlignment="Center" x:Name="BridgeStatusText" Style="{StaticResource CaptionTextBlockStyle}" Text="未启动" />
                            <ToggleSwitch x:Name="BridgeEnabledToggle" Toggled="BridgeEnabledToggle_Toggled" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="复制到浏览器插件里"
                        Header="连接密钥">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8D7;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="BridgeTokenBox"
                                Width="360"
                                IsReadOnly="True"
                                FontFamily="Consolas" />
                            <Button x:Name="BridgeCopyButton" Click="BridgeCopy_Click" Content="复制密钥" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="还没整理的图片"
                        Header="待处理记录">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8B5;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" x:Name="PendingText" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                            <Button x:Name="BridgeRefreshButton" Click="BridgeRefresh_Click" Content="刷新" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <!--  归档  -->
                    <TextBlock
                        Margin="1,24,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="归档" />

                    <ctc:SettingsCard
                        Header="新图片归档提醒">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE7E7;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="NotifyNewImagesToggle" Toggled="NotifyNewImagesToggle_Toggled" />
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="按作品和画师自动建子文件夹"
                        Header="按标签自动分目录">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="ArchiveAutoByTagsToggle" Toggled="ArchiveAutoByTagsToggle_Toggled" />
                    </ctc:SettingsCard>

                    <!--  标签  -->
                    <TextBlock
                        Margin="1,24,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="标签" />

                    <ctc:SettingsCard
                        Description="用文件夹名生成标签，只对新加入的图片生效"
                        Header="按文件夹自动打标签">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8EC;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch x:Name="AutoTagToggle" Toggled="AutoTagToggle_Toggled" />
                            <controls:SelectionDropDown
                                x:Name="AutoTagDepthBox"
                                MinWidth="80"
                                ToolTipService.ToolTip="从图库根目录往下取几层文件夹名作为标签"
                                SelectionChanged="AutoTagDepth_SelectionChanged">
                                <ComboBoxItem Content="1 层" Tag="1" />
                                <ComboBoxItem Content="2 层" Tag="2" />
                                <ComboBoxItem Content="3 层" Tag="3" />
                                <ComboBoxItem Content="4 层" Tag="4" />
                                <ComboBoxItem Content="5 层" Tag="5" />
                            </controls:SelectionDropDown>
                        </StackPanel>
                    </ctc:SettingsCard>
                    <!--  敏感内容  -->
                    <TextBlock
                        Margin="1,24,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="敏感内容" />

                    <ctc:SettingsCard
                        Description="敏感图片显示为清晰、模糊还是隐藏"
                        Header="显示方式">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE7BA;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <RadioButton x:Name="NsfwNormalRadio" Content="正常显示" Tag="normal" Checked="NsfwDisplay_Checked" />
                            <RadioButton x:Name="NsfwBlurRadio" Content="模糊" Tag="blur" Checked="NsfwDisplay_Checked" />
                            <RadioButton x:Name="NsfwHideRadio" Content="隐藏" Tag="hide" Checked="NsfwDisplay_Checked" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        x:Name="NsfwStrengthCard"
                        Header="模糊强度"
                        Visibility="Collapsed">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE7BA;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <Grid Width="260" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="NsfwStrengthSlider" Minimum="0" Maximum="100"
                                    StepFrequency="1" TickFrequency="1" SnapsTo="StepValues"
                                    VerticalAlignment="Center" AutomationProperties.Name="模糊强度"
                                    ValueChanged="NsfwStrength_ValueChanged" />
                            <TextBlock x:Name="NsfwStrengthValue" Grid.Column="1" MinWidth="30"
                                       TextAlignment="Right" VerticalAlignment="Center" Text="100" />
                        </Grid>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="已识别、敏感、未识别"
                        Header="识别进度">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE9D9;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <TextBlock VerticalAlignment="Center" x:Name="NsfwSummaryText" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="选择模型所在的文件夹"
                        Header="识别模型">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <Grid ColumnSpacing="8" MaxWidth="420">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NsfwModelText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="未配置" MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=NsfwModelText}" />
                            <Button Grid.Column="1" x:Name="NsfwPickButton" VerticalAlignment="Center" Click="NsfwPickFolder_Click" Content="选择文件夹" />
                        </Grid>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="识别后同步更新 SFW/NSFW 标签"
                        Header="识别结果写入标签">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8EC;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AutoNsfwTagToggle" Toggled="AutoNsfwTagToggle_Toggled" />
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Header="重新识别">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE895;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <Grid ColumnSpacing="8" MaxWidth="420">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NsfwScanText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" x:Name="NsfwPreviewButton" VerticalAlignment="Center" Click="NsfwPreview_Click" Content="预览" />
                            <Button Grid.Column="2" x:Name="NsfwScanButton" VerticalAlignment="Center" Click="NsfwScan_Click" Content="开始识别" />
                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                x:Name="NsfwCancelButton"
                                Click="NsfwCancel_Click"
                                Content="取消"
                                Visibility="Collapsed" />
                        </Grid>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Header="最近错误">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE7BA;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" x:Name="SyncErrorText" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                            <Button Click="SyncErrorView_Click" Content="查看" />
                            <Button Click="SyncErrorClear_Click" Content="清空" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <!--  系统集成  -->
                    <TextBlock
                        Margin="1,24,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="系统集成" />

                    <ctc:SettingsCard
                        Header="关闭时最小化到托盘">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TrayToggle" Toggled="TrayToggle_Toggled" />
                    </ctc:SettingsCard>

                    <ctc:SettingsCard Header="开机自启">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE7E8;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="AutoStartStatusText"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="" />
                            <ToggleSwitch x:Name="AutoStartToggle" Toggled="AutoStartToggle_Toggled" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Header="打开方式">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:SelectionDropDown x:Name="OpenModeBox" MinWidth="140" SelectionChanged="OpenMode_SelectionChanged">
                                <ComboBoxItem Content="照片" Tag="photos" />
                                <ComboBoxItem Content="系统默认程序" Tag="default" />
                                <ComboBoxItem Content="每次选择程序" Tag="openwith" />
                                <ComboBoxItem Content="指定程序" Tag="custom" />
                            </controls:SelectionDropDown>
                            <Button
                                x:Name="OpenProgramButton"
                                Click="OpenProgram_Click"
                                Content="选择程序…"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="OpenProgramText"
                                MaxWidth="200"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text=""
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="清理后不影响图片和标签，下次浏览会重新生成"
                        Header="缩略图缓存">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" x:Name="ThumbCacheText" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                            <Button x:Name="ThumbCacheClearButton" Click="ThumbCacheClear_Click" Content="清理" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <!--  高级  -->
                    <TextBlock
                        Margin="1,24,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="高级" />

                    <ctc:SettingsCard
                        Description="决定哪些标签显示为画面类型"
                        Header="标签类型映射">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" x:Name="KindWhitelistText" Style="{StaticResource CaptionTextBlockStyle}" Text="—" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                            <Button Click="KindWhitelistOpen_Click" Content="打开文件" />
                            <Button Click="KindWhitelistReload_Click" Content="重新加载" />
                            <Button Click="KindWhitelistReset_Click" Content="恢复默认" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Header="插件端口">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE774;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="BridgePortBox" Width="90" />
                            <Button Click="BridgePortApply_Click" Content="应用" />
                            <TextBlock x:Name="BridgePortStatusText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="" />
                        </StackPanel>
                    </ctc:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
