<?xml version="1.0" encoding="utf-8"?>
<!--
    设置页。
    照搬 photos 的 PhotosManager/Views/Pages/SettingsPage.xaml：
    - 页头 SimplePageHeader：margin 32,28,48,26 / 图标 E713 FontSize 24 / 标题 FontSize 24
    - 内容 ScrollViewer padding 32,0,48,0 / StackPanel MaxWidth 958 / Spacing 3
    - 首页保留常用偏好，四个二级页面的控件常驻，导航不重建后台任务
    - SettingsCard：Header「应用主题」/ Description「浅色、深色或跟随 Windows」/ HeaderIcon E790 FontSize 16
    - 右侧 DropDownButton + MenuFlyout 三项（浅色 / 深色 / 跟随 Windows），RadioMenuFlyoutItem 互斥
-->
<UserControl
    x:Class="Gallery.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Gallery.Controls"
    Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PackDropBackgroundBrush" Color="#151515" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PackDropBackgroundBrush" Color="#E3E3E3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PackDropBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        <!-- 设置页选项按内容宽度排列，避免原生最小宽度撑大短标签之间的距离。 -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="SettingsRoot" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  齿轮与“设置”固定位置；首页为标题，二级页原位替换为原生返回按钮。 -->
        <Grid Grid.Row="0" MaxWidth="958" Margin="32,28,48,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon VerticalAlignment="Center" FontSize="24" Glyph="&#xE713;" />
            <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="SettingsHomeTitle" Text="设置" FontSize="24"
                           Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="1" />
                <Button x:Name="SettingsHomeBreadcrumb" Visibility="Collapsed"
                        Click="SettingsBack_Click" Background="Transparent" BorderThickness="0"
                        MinWidth="0" MinHeight="0" Padding="0"
                        HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                        AutomationProperties.Name="设置" ToolTipService.ToolTip="返回设置">
                    <TextBlock Text="设置" FontSize="24" Style="{StaticResource TitleTextBlockStyle}" />
                </Button>
            </Grid>
            <FontIcon x:Name="SettingsBreadcrumbSeparator" Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                      Margin="12,0,0,0" Opacity="0.5" Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock x:Name="SettingsPageTitle" Grid.Column="3" FontSize="24" Margin="12,0,0,0"
                       Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Visibility="Collapsed"
                       AutomationProperties.HeadingLevel="1" TextTrimming="CharacterEllipsis" />
        </Grid>

        <ScrollViewer
            x:Name="SettingsScroll"
            Grid.Row="1"
            Padding="32,0,48,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsHorizontalRailEnabled="False"
            IsVerticalRailEnabled="True"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled">
            <Grid>
                <StackPanel x:Name="HomeSettingsPanel" MaxWidth="958" Margin="0,0,0,64" Spacing="3" Visibility="Visible">
                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="外观与显示" />

                    <ctc:SettingsCard
                        Description="浅色、深色或跟随 Windows"
                        Header="应用主题">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE790;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <DropDownButton x:Name="ThemeDropdown" Content="深色">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <RadioMenuFlyoutItem
                                        x:Name="ThemeLightItem"
                                        Click="ThemeLightItem_Click"
                                        GroupName="AppTheme"
                                        Text="浅色" />
                                    <RadioMenuFlyoutItem
                                        x:Name="ThemeDarkItem"
                                        Click="ThemeDarkItem_Click"
                                        GroupName="AppTheme"
                                        Text="深色" />
                                    <RadioMenuFlyoutItem
                                        x:Name="ThemeDefaultItem"
                                        Click="ThemeDefaultItem_Click"
                                        GroupName="AppTheme"
                                        Text="跟随 Windows" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="只影响角色、作品的标签贴纸和评审页标签；搜索候选自动跟随输入语言，缺少对应语言名称时回退"
                        Header="标签显示">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8D2;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <controls:SelectionDropDown
                            x:Name="TagDisplayModeBox"
                            MinWidth="180"
                            SelectionChanged="TagDisplayMode_SelectionChanged">
                            <ComboBoxItem Content="中文全名" Tag="zh_full" />
                            <ComboBoxItem Content="中文短名" Tag="zh_short" />
                            <ComboBoxItem Content="英文来源名" Tag="original" />
                            <ComboBoxItem Content="标签原名" Tag="canonical" />
                            <ComboBoxItem Content="首选别名" Tag="alias" />
                        </controls:SelectionDropDown>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="详情面板显示 Danbooru 作者在作品下写的说明；没有说明的图片不占位"
                        Header="作者评论">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8BD;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AuthorCommentaryToggle" Toggled="AuthorCommentaryToggle_Toggled" />
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="敏感图片显示为清晰、模糊还是隐藏"
                        Header="显示方式">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE7BA;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <RadioButton x:Name="NsfwNormalRadio" Content="正常显示" Tag="normal" Checked="NsfwDisplay_Checked" />
                            <RadioButton x:Name="NsfwBlurRadio" Content="模糊" Tag="blur" Checked="NsfwDisplay_Checked" />
                            <RadioButton x:Name="NsfwHideRadio" Content="隐藏" Tag="hide" Checked="NsfwDisplay_Checked" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        x:Name="NsfwStrengthCard"
                        Header="模糊强度"
                        Visibility="Collapsed">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE7BA;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <Grid Width="260" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="NsfwStrengthSlider" Minimum="0" Maximum="100"
                                    StepFrequency="1" TickFrequency="1" SnapsTo="StepValues"
                                    VerticalAlignment="Center" AutomationProperties.Name="模糊强度"
                                    ValueChanged="NsfwStrength_ValueChanged" />
                            <TextBlock x:Name="NsfwStrengthValue" Grid.Column="1" MinWidth="30"
                                       TextAlignment="Right" VerticalAlignment="Center" Text="100" />
                        </Grid>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="在搜索框下方显示最近搜索的词"
                        Header="显示搜索历史">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE81C;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="SearchHistoryToggle" Toggled="SearchHistoryToggle_Toggled" />
                    </ctc:SettingsCard>

                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="系统集成" />

                    <ctc:SettingsCard
                        Header="关闭时最小化到托盘">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TrayToggle" Toggled="TrayToggle_Toggled" />
                    </ctc:SettingsCard>

                    <ctc:SettingsCard Header="开机自启">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE7E8;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="AutoStartStatusText"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="" />
                            <ToggleSwitch x:Name="AutoStartToggle" Toggled="AutoStartToggle_Toggled" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Header="打开方式">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:SelectionDropDown x:Name="OpenModeBox" MinWidth="140" SelectionChanged="OpenMode_SelectionChanged">
                                <ComboBoxItem Content="照片" Tag="photos" />
                                <ComboBoxItem Content="系统默认程序" Tag="default" />
                                <ComboBoxItem Content="每次选择程序" Tag="openwith" />
                                <ComboBoxItem Content="指定程序" Tag="custom" />
                            </controls:SelectionDropDown>
                            <Button
                                x:Name="OpenProgramButton"
                                Click="OpenProgram_Click"
                                Content="选择程序…"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="OpenProgramText"
                                MaxWidth="200"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text=""
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Header="设为默认应用"
                        Description="让图片和视频默认由 Gallery 打开；系统不允许程序直接改默认，需要在打开的设置页里确认">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8B9;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="DefaultAppsStatusText"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="" />
                            <Button
                                x:Name="DefaultAppsButton"
                                Click="DefaultApps_Click"
                                Content="去设置" />
                        </StackPanel>
                    </ctc:SettingsCard>
                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="功能设置" />

                    <ctc:SettingsCard x:Name="ImportSettingsEntry" Header="导入与归档"
                        Description="通知、文件夹标签、自动分目录与历史保留" Tag="Import" IsClickEnabled="True"
                        IsActionIconVisible="True" Click="SettingsCategory_Click">
                        <ctc:SettingsCard.HeaderIcon><FontIcon FontSize="16" Glyph="&#xE8B5;" /></ctc:SettingsCard.HeaderIcon>
                        <ctc:SettingsCard.ActionIcon><FontIcon FontSize="12" Glyph="&#xE76C;" /></ctc:SettingsCard.ActionIcon>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard x:Name="CatalogSettingsEntry" Header="资料库"
                        Description="拖入词库包，可并存多个" Tag="Catalog" IsClickEnabled="True"
                        IsActionIconVisible="True" Click="SettingsCategory_Click">
                        <ctc:SettingsCard.HeaderIcon><FontIcon FontSize="16" Glyph="&#xE8F1;" /></ctc:SettingsCard.HeaderIcon>
                        <ctc:SettingsCard.ActionIcon><FontIcon FontSize="12" Glyph="&#xE76C;" /></ctc:SettingsCard.ActionIcon>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard x:Name="RecognitionSettingsEntry" Header="智能识别"
                        Description="模型、导入自动识别与全库重新识别" Tag="Recognition" IsClickEnabled="True"
                        IsActionIconVisible="True" Click="SettingsCategory_Click">
                        <ctc:SettingsCard.HeaderIcon><FontIcon FontSize="16" Glyph="&#xE713;" /></ctc:SettingsCard.HeaderIcon>
                        <ctc:SettingsCard.ActionIcon><FontIcon FontSize="12" Glyph="&#xE76C;" /></ctc:SettingsCard.ActionIcon>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard x:Name="BridgeSettingsEntry" Header="浏览器插件"
                        Description="连接状态、密钥与插件端口" Tag="Bridge" IsClickEnabled="True"
                        IsActionIconVisible="True" Click="SettingsCategory_Click">
                        <ctc:SettingsCard.HeaderIcon><FontIcon FontSize="16" Glyph="&#xE774;" /></ctc:SettingsCard.HeaderIcon>
                        <ctc:SettingsCard.ActionIcon><FontIcon FontSize="12" Glyph="&#xE76C;" /></ctc:SettingsCard.ActionIcon>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard x:Name="StorageSettingsEntry" Header="存储与诊断"
                        Description="缩略图缓存与错误记录" Tag="Storage" IsClickEnabled="True"
                        IsActionIconVisible="True" Click="SettingsCategory_Click">
                        <ctc:SettingsCard.HeaderIcon><FontIcon FontSize="16" Glyph="&#xE9CE;" /></ctc:SettingsCard.HeaderIcon>
                        <ctc:SettingsCard.ActionIcon><FontIcon FontSize="12" Glyph="&#xE76C;" /></ctc:SettingsCard.ActionIcon>
                    </ctc:SettingsCard>
                    <ctc:SettingsCard Header="关于" Description="版本信息与应用更新" Tag="About" IsClickEnabled="True"
                        IsActionIconVisible="True" Click="SettingsCategory_Click">
                        <ctc:SettingsCard.HeaderIcon><FontIcon FontSize="16" Glyph="&#xE946;" /></ctc:SettingsCard.HeaderIcon>
                        <ctc:SettingsCard.ActionIcon><FontIcon FontSize="12" Glyph="&#xE76C;" /></ctc:SettingsCard.ActionIcon>
                    </ctc:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="ImportSettingsPanel" MaxWidth="958" Margin="0,0,0,64" Spacing="3" Visibility="Collapsed">
                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="归档" />

                    <ctc:SettingsCard
                        Header="新图片归档提醒">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE7E7;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="NotifyNewImagesToggle" Toggled="NotifyNewImagesToggle_Toggled" />
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="按已配置的个人目录规则分流；未配置时请先添加规则"
                        Header="按标签自动分目录">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="ArchiveAutoByTagsToggle" Toggled="ArchiveAutoByTagsToggle_Toggled" />
                    </ctc:SettingsCard>

                    <Border Margin="0,12,0,12" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="标签与归档目录" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="同时命中时采用最上面的启用规则。未命中时按作品和画师分目录。"
                                        TextWrapping="Wrap" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <Button x:Name="DirectoryRuleAddButton" Grid.Column="1" Content="添加规则" Click="DirectoryRuleAdd_Click" />
                            </Grid>
                            <StackPanel x:Name="DirectoryRulesList" Spacing="6" />
                            <TextBlock Text="保存规则不会搬动已有图片；只影响之后的归档和手动整理。规则随个人备份保存。"
                                TextWrapping="Wrap" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="DirectoryRulesStatus" TextWrapping="Wrap" Visibility="Collapsed"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <ctc:SettingsCard
                        Description="清理历史时的默认保留范围；只删队列记录，不删文件"
                        Header="历史保留">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE81C;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <controls:SelectionDropDown
                            x:Name="HistoryKeepBox"
                            MinWidth="140"
                            SelectionChanged="HistoryKeep_SelectionChanged">
                            <ComboBoxItem Content="永久（不清理）" Tag="0" />
                            <ComboBoxItem Content="最近 7 天" Tag="7" />
                            <ComboBoxItem Content="最近 30 天" Tag="30" />
                            <ComboBoxItem Content="最近 90 天" Tag="90" />
                            <ComboBoxItem Content="最近 180 天" Tag="180" />
                            <ComboBoxItem Content="最近 365 天" Tag="365" />
                        </controls:SelectionDropDown>
                    </ctc:SettingsCard>

                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="文件夹标签" />

                    <ctc:SettingsCard
                        Description="用文件夹名生成标签，只对新加入的图片生效"
                        Header="按文件夹自动打标签">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8EC;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch x:Name="AutoTagToggle" Toggled="AutoTagToggle_Toggled" />
                            <controls:SelectionDropDown
                                x:Name="AutoTagDepthBox"
                                MinWidth="80"
                                ToolTipService.ToolTip="从图库根目录往下取几层文件夹名作为标签"
                                SelectionChanged="AutoTagDepth_SelectionChanged">
                                <ComboBoxItem Content="1 层" Tag="1" />
                                <ComboBoxItem Content="2 层" Tag="2" />
                                <ComboBoxItem Content="3 层" Tag="3" />
                                <ComboBoxItem Content="4 层" Tag="4" />
                                <ComboBoxItem Content="5 层" Tag="5" />
                            </controls:SelectionDropDown>
                        </StackPanel>
                    </ctc:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="RecognitionSettingsPanel" MaxWidth="958" Margin="0,0,0,64" Spacing="3" Visibility="Collapsed">
                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="模型与设备" />

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Margin="0,2,0,0"
                                    FontSize="16"
                                    Glyph="&#xE8B7;"
                                    VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="识别模型" />
                                    <TextBlock
                                        Opacity="0.6"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="支持压缩包或文件夹，同时只能保留一个模型"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                x:Name="ModelDropZone"
                                Height="96"
                                AllowDrop="True"
                                Background="Transparent"
                                DragLeave="PackDrop_DragLeave"
                                DragOver="PackDrop_DragOver"
                                Drop="PackDrop_Drop">
                                <Rectangle x:Name="ModelDropOutline"
                                    Fill="{ThemeResource PackDropBackgroundBrush}"
                                    IsHitTestVisible="False"
                                    RadiusX="6"
                                    RadiusY="6"
                                    Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                    StrokeDashArray="4 3"
                                    StrokeThickness="1" />
                                <StackPanel
                                    Margin="48,8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Spacing="4">
                                    <FontIcon FontSize="16" Glyph="&#xE8E5;" Opacity="0.55" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="拖入模型压缩包或文件夹" />
                                </StackPanel>
                                <Button
                                    x:Name="NsfwPickButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    Margin="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="选择模型文件夹"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NsfwPickFolder_Click"
                                    ToolTipService.ToolTip="选择模型文件夹">
                                    <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="ModelPackList" Spacing="6" />
                            <TextBlock
                                x:Name="ModelPackStatus"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <ctc:SettingsCard
                        Description="自动：先用显卡，跑不通回退 CPU"
                        Header="识别设备">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE945;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <controls:SelectionDropDown
                            x:Name="NsfwDeviceBox"
                            MinWidth="120"
                            SelectionChanged="NsfwDevice_SelectionChanged">
                            <ComboBoxItem Content="自动" Tag="auto" />
                            <ComboBoxItem Content="CPU" Tag="cpu" />
                            <ComboBoxItem Content="GPU" Tag="gpu" />
                        </controls:SelectionDropDown>
                    </ctc:SettingsCard>

                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="导入识别" />

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid ColumnSpacing="16" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon FontSize="16" Glyph="&#xE8D4;" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       AutomationProperties.HeadingLevel="Level3"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" Text="导入时自动识别" />
                            <ToggleSwitch Grid.Column="2" x:Name="AutoModelTagsToggle"
                                          MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="导入时自动识别"
                                          Toggled="AutoModelTagsToggle_Toggled" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Text="PixAI 一次识别，写入所选标签。已有角色、作品只补空，类型追加。" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                        Margin="0,12,0,0" Orientation="Horizontal" Spacing="24">
                                <CheckBox x:Name="ImportTagCharacterCheck" Content="角色"
                                          AutomationProperties.Name="导入识别：角色"
                                          Checked="ImportTag_Changed" Unchecked="ImportTag_Changed" />
                                <CheckBox x:Name="ImportTagWorkCheck" Content="作品"
                                          AutomationProperties.Name="导入识别：作品"
                                          Checked="ImportTag_Changed" Unchecked="ImportTag_Changed" />
                                <CheckBox x:Name="ImportTagKindCheck" Content="类型"
                                          AutomationProperties.Name="导入识别：类型"
                                          Checked="ImportTag_Changed" Unchecked="ImportTag_Changed" />
                                <CheckBox x:Name="ImportTagRatingCheck" Content="分级"
                                          AutomationProperties.Name="导入识别：分级"
                                          Checked="ImportTag_Changed" Unchecked="ImportTag_Changed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="图库重新识别" />

                    <ctc:SettingsCard
                        Description="已识别、敏感、未识别"
                        Header="识别进度">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE9D9;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <TextBlock VerticalAlignment="Center" x:Name="NsfwSummaryText" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                    </ctc:SettingsCard>

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid ColumnSpacing="16" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon FontSize="16" Glyph="&#xE895;" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       AutomationProperties.HeadingLevel="Level3"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" Text="重新识别" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="NsfwPreviewButton" VerticalAlignment="Center"
                                        Click="NsfwPreview_Click" Content="预览" />
                                <Button x:Name="NsfwScanButton" VerticalAlignment="Center"
                                        Click="NsfwScan_Click" Content="开始识别" />
                                <Button x:Name="NsfwCancelButton" VerticalAlignment="Center"
                                        Click="NsfwCancel_Click" Content="取消" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Text="扫描已入库图片，写入所选标签；可先预览结果。" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                        Margin="0,12,0,0" Orientation="Horizontal" Spacing="24">
                                <CheckBox x:Name="RescanTagCharacterCheck" Content="角色"
                                          AutomationProperties.Name="重新识别：角色"
                                          Checked="RescanTag_Changed" Unchecked="RescanTag_Changed" />
                                <CheckBox x:Name="RescanTagWorkCheck" Content="作品"
                                          AutomationProperties.Name="重新识别：作品"
                                          Checked="RescanTag_Changed" Unchecked="RescanTag_Changed" />
                                <CheckBox x:Name="RescanTagKindCheck" Content="类型"
                                          AutomationProperties.Name="重新识别：类型"
                                          Checked="RescanTag_Changed" Unchecked="RescanTag_Changed" />
                                <CheckBox x:Name="RescanTagRatingCheck" Content="分级"
                                          AutomationProperties.Name="重新识别：分级"
                                          Checked="RescanTag_Changed" Unchecked="RescanTag_Changed" />
                            </StackPanel>
                            <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                  Margin="0,8,0,0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Text="已有标签" />
                                    <controls:SelectionDropDown x:Name="RescanWriteModeBox" MinWidth="180"
                                                                AutomationProperties.Name="重新识别时已有标签的处理方式"
                                                                SelectionChanged="RescanWriteMode_SelectionChanged">
                                        <ComboBoxItem Content="只追加，不覆盖" Tag="append" />
                                        <ComboBoxItem Content="覆盖角色/作品/类型" Tag="overwrite" />
                                    </controls:SelectionDropDown>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="NsfwScanText" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Text="" TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="标签映射" />

                    <ctc:SettingsCard
                        Description="决定哪些标签显示为画面类型"
                        Header="标签类型映射">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" x:Name="KindWhitelistText" Style="{StaticResource CaptionTextBlockStyle}" Text="—" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                            <Button Click="KindWhitelistOpen_Click" Content="打开文件" />
                            <Button Click="KindWhitelistReload_Click" Content="重新加载" />
                            <Button Click="KindWhitelistReset_Click" Content="恢复默认" />
                        </StackPanel>
                    </ctc:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="CatalogSettingsPanel" MaxWidth="958" Margin="0,0,0,64" Spacing="3" Visibility="Collapsed">
                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="资料库" />

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Margin="0,2,0,0"
                                    FontSize="16"
                                    Glyph="&#xE8F1;"
                                    VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="资料库" />
                                    <TextBlock
                                        Opacity="0.6"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="拖入下载到的资料库文件，可以放多个"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                x:Name="CatalogDropZone"
                                Height="96"
                                AllowDrop="True"
                                Background="Transparent"
                                DragLeave="PackDrop_DragLeave"
                                DragOver="PackDrop_DragOver"
                                Drop="PackDrop_Drop">
                                <Rectangle x:Name="CatalogDropOutline"
                                    Fill="{ThemeResource PackDropBackgroundBrush}"
                                    IsHitTestVisible="False"
                                    RadiusX="6"
                                    RadiusY="6"
                                    Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                    StrokeDashArray="4 3"
                                    StrokeThickness="1" />
                                <StackPanel
                                    Margin="48,8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Spacing="4">
                                    <FontIcon FontSize="16" Glyph="&#xE8E5;" Opacity="0.55" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="拖入资料库压缩包、文件夹或 JSON" />
                                </StackPanel>
                                <Button
                                    x:Name="CatalogPickButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    Margin="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="选择资料库文件夹"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="CatalogPickFolder_Click"
                                    ToolTipService.ToolTip="选择资料库文件夹">
                                    <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="CatalogPackList" Spacing="6" />
                            <TextBlock
                                x:Name="CatalogPackStatus"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <ctc:SettingsCard Margin="0,12,0,0" Header="导出资料库"
                        Description="把全部资料库包打包成一个压缩包；别人导入后得到相同的条目。不含个人设置和识别模型">
                        <Button x:Name="CatalogExportButton" Content="导出…" Click="CatalogExport_Click" />
                    </ctc:SettingsCard>
                    <TextBlock x:Name="CatalogExportStatus" TextWrapping="Wrap" Visibility="Collapsed"
                        Style="{StaticResource CaptionTextBlockStyle}" Margin="16,6,16,0" />
                    <ctc:SettingsCard Margin="0,12,0,0" Header="个人规则备份"
                        Description="保存和恢复标签关联、显示设置、目录规则与历史整理决定；不随公共资料包共享">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PersonalRulesImportButton" Content="导入个人备份" Click="PersonalRulesImport_Click" />
                            <Button x:Name="PersonalRulesExportButton" Content="导出个人备份" Click="PersonalRulesExport_Click" />
                        </StackPanel>
                    </ctc:SettingsCard>
                    <TextBlock x:Name="PersonalRulesStatus" TextWrapping="Wrap" Visibility="Collapsed"
                        Style="{StaticResource CaptionTextBlockStyle}" Margin="16,6,16,0" />
                </StackPanel>

                <StackPanel x:Name="BridgeSettingsPanel" MaxWidth="958" Margin="0,0,0,64" Spacing="3" Visibility="Collapsed">
                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="连接" />

                    <ctc:SettingsCard
                        x:Name="BridgeStatusCard"
                        Description="浏览器插件是否已连接"
                        Header="桥接状态">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE774;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock VerticalAlignment="Center" x:Name="BridgeStatusText" Style="{StaticResource CaptionTextBlockStyle}" Text="未启动" />
                            <ToggleSwitch x:Name="BridgeEnabledToggle" Toggled="BridgeEnabledToggle_Toggled" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="复制到浏览器插件里"
                        Header="连接密钥">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8D7;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="BridgeTokenBox"
                                Width="360"
                                IsReadOnly="True"
                                FontFamily="Consolas" />
                            <Button x:Name="BridgeCopyButton" Click="BridgeCopy_Click" Content="复制密钥" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <ctc:SettingsCard
                        Description="还没整理的图片"
                        Header="待处理记录">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE8B5;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" x:Name="PendingText" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                            <Button x:Name="BridgeRefreshButton" Click="BridgeRefresh_Click" Content="刷新" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="连接配置" />

                    <ctc:SettingsCard
                        Header="插件端口">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE774;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="BridgePortBox" Width="90" />
                            <Button Click="BridgePortApply_Click" Content="应用" />
                            <TextBlock x:Name="BridgePortStatusText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="" />
                        </StackPanel>
                    </ctc:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="StorageSettingsPanel" MaxWidth="958" Margin="0,0,0,64" Spacing="3" Visibility="Collapsed">
                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="存储" />

                    <ctc:SettingsCard
                        Description="清理后不影响图片和标签，下次浏览会重新生成"
                        Header="缩略图缓存">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" x:Name="ThumbCacheText" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                            <Button x:Name="ThumbCacheClearButton" Click="ThumbCacheClear_Click" Content="清理" />
                        </StackPanel>
                    </ctc:SettingsCard>

                    <TextBlock Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="诊断" />

                    <ctc:SettingsCard
                        Header="最近错误">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE7BA;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" x:Name="SyncErrorText" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                            <Button Click="SyncErrorView_Click" Content="查看" />
                            <Button Click="SyncErrorClear_Click" Content="清空" />
                        </StackPanel>
                    </ctc:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="AboutSettingsPanel" MaxWidth="958" Margin="0,24,0,64" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Gallery" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="AppVersionText" />
                    <ToggleSwitch x:Name="AutoUpdateToggle" Header="启动时检查更新" OnContent="已开启" OffContent="已关闭" Toggled="AutoUpdate_Toggled" />
                    <TextBlock Text="开启后，每次启动检查一次。下载和安装前都会征求你的同意。" TextWrapping="Wrap" />
                    <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" />
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" />
                    <Button x:Name="UpdateDetailsButton" Content="查看新版变化" Visibility="Collapsed" Click="UpdateDetails_Click" />
                    <ProgressBar x:Name="UpdateDownloadProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <Button x:Name="CancelUpdateButton" Content="取消下载" Visibility="Collapsed" Click="CancelUpdate_Click" />
                    <Button x:Name="InstallUpdateButton" Content="安装并重启" Visibility="Collapsed" Click="InstallUpdate_Click" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
