<?xml version="1.0" encoding="utf-8"?>
<!--
    设置页。
    照搬 photos 的 PhotosManager/Views/Pages/SettingsPage.xaml：
    - 页头 SimplePageHeader：margin 32,28,48,26 / 图标 E713 FontSize 20 / 标题 FontSize 24
    - 内容 ScrollViewer padding 32,0,48,0 / StackPanel MaxWidth 958 / Spacing 3
    - 副标题「个性化」margin 1,24,0,6，BodyStrongTextBlockStyle
    - SettingsCard：Header「应用主题」/ Description「选择要显示的应用主题」/ HeaderIcon E790 FontSize 16
    - 右侧 DropDownButton + MenuFlyout 三项（浅色 / 深色 / Windows 默认），RadioMenuFlyoutItem 互斥
-->
<UserControl
    x:Class="Gallery.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页头：SimplePageHeader（图标 + 标题），margin 32,28,48,26  -->
        <Grid Grid.Row="0" Margin="32,28,48,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="20"
                Glyph="&#xE713;" />
            <TextBlock
                Grid.Column="1"
                MinWidth="124"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="1"
                FontSize="24"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="设置"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="32,0,48,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsHorizontalRailEnabled="False"
            IsVerticalRailEnabled="True"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled">
            <Grid>
                <StackPanel
                    MaxWidth="958"
                    Margin="0,0,0,64"
                    Orientation="Vertical"
                    Spacing="3">
                    <StackPanel.ChildrenTransitions>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </StackPanel.ChildrenTransitions>

                    <!--  个性化  -->
                    <TextBlock
                        Margin="1,24,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="个性化" />

                    <ctc:SettingsCard
                        Description="选择要显示的应用主题"
                        Header="应用主题">
                        <ctc:SettingsCard.HeaderIcon>
                            <FontIcon FontSize="16" Glyph="&#xE790;" />
                        </ctc:SettingsCard.HeaderIcon>
                        <DropDownButton x:Name="ThemeDropdown" Content="深色">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <RadioMenuFlyoutItem
                                        x:Name="ThemeLightItem"
                                        Click="ThemeLightItem_Click"
                                        GroupName="AppTheme"
                                        Text="浅色" />
                                    <RadioMenuFlyoutItem
                                        x:Name="ThemeDarkItem"
                                        Click="ThemeDarkItem_Click"
                                        GroupName="AppTheme"
                                        Text="深色" />
                                    <RadioMenuFlyoutItem
                                        x:Name="ThemeDefaultItem"
                                        Click="ThemeDefaultItem_Click"
                                        GroupName="AppTheme"
                                        Text="Windows 默认" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </ctc:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
