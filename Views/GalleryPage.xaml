<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Gallery.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gallery.Controls"
    Background="Transparent">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  头部：margin 0,16,16,8 / padding 32,12,32,18 / 圆角 6  -->
        <Grid
            x:Name="Header"
            Margin="0,16,16,8"
            Padding="32,12,32,18"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="SubtitleText"
                    Margin="1,4,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>

            <CommandBar
                x:Name="Bar"
                Grid.Column="1"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                ClosedDisplayMode="Compact"
                DefaultLabelPosition="Right"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Right"
                IsDynamicOverflowEnabled="True"
                OverflowButtonVisibility="Visible">
                <!--  照搬 CommandBarStyles.xaml 对 AppBarButton 的覆盖  -->
                <CommandBar.Resources>
                    <Thickness x:Key="CommandBarElementMargin">2,0,2,0</Thickness>
                    <Thickness x:Key="AppBarButtonSubItemChevronMargin">0,20,12,0</Thickness>
                    <Thickness x:Key="AppBarButtonInnerBorderMargin">2,7,2,7</Thickness>
                    <Thickness x:Key="AppBarEllipsisButtonInnerBorderMargin">2,7,6,7</Thickness>
                    <!--  这条是关键：WinUI 默认是 E974(ChevronRight ›)，Photos 覆盖成 E70D(ChevronDown ∨)  -->
                    <x:String x:Key="AppBarButtonFlyoutGlyph">&#xE70D;</x:String>
                    <x:String x:Key="AppBarButtonOverflowFlyoutGlyph">&#xE70D;</x:String>
                </CommandBar.Resources>

                <!--  选择：Photos 里唯一一个「图标 + 文字」的按钮
                      Label 文案来自 CommandBar_SelectSelectionText / CommandBar_CancelSelectionText
                      → 可见文字是「选择」/「取消选择」（不是 UIA 的 Name「选择项目」）
                      图标来自 IconService.GetCheckMarkIcon() = E73A（方框勾选）/ GetCancelIcon() = E711
                      带 AppBarButtonHighlightedStyles 的灰底高亮（Styles/AppBarButtonHighlightedStyles.xaml）  -->
                <AppBarButton
                    x:Name="SelectButton"
                    Height="48"
                    Click="SelectButton_Click"
                    Label="选择"
                    LabelPosition="Default">
                    <AppBarButton.Resources>
                        <!--  照搬 AppBarButtonHighlightedStyles.xaml：选择按钮的灰底高亮  -->
                        <StaticResource x:Key="AppBarButtonBackground" ResourceKey="ControlFillColorDefaultBrush" />
                        <StaticResource x:Key="AppBarButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                        <StaticResource x:Key="AppBarButtonBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                        <StaticResource x:Key="AppBarButtonBorderBrush" ResourceKey="ControlElevationBorderBrush" />
                        <StaticResource x:Key="AppBarButtonBorderBrushPointerOver" ResourceKey="ControlElevationBorderBrush" />
                        <StaticResource x:Key="AppBarButtonBorderBrushPressed" ResourceKey="ControlStrokeColorDefaultBrush" />
                    </AppBarButton.Resources>
                    <AppBarButton.Icon>
                        <FontIcon
                            x:Name="SelectIcon"
                            FontSize="12"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE73A;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <!--  排序 / 筛选 / 布局：带下拉小箭头，实测 62 宽  -->
                <AppBarButton
                    x:Name="SortButton"
                    Width="62"
                    Height="48"
                    Label="排序选项和方向"
                    LabelPosition="Collapsed">
                    <AppBarButton.Resources>
                        <Visibility x:Key="AppBarButtonHasFlyoutChevronVisibility">Visible</Visibility>
                    </AppBarButton.Resources>
                    <AppBarButton.Icon>
                        <FontIcon
                            FontSize="16"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE174;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="SortMenu" Placement="Bottom">
                            <MenuFlyoutItem Click="SortByDateTaken_Click" Text="拍摄日期" />
                            <MenuFlyoutItem Click="SortByDateCreated_Click" Text="创建日期" />
                            <MenuFlyoutItem Click="SortByDateModified_Click" Text="修改日期" />
                            <MenuFlyoutItem Click="SortByName_Click" Text="名字" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="SortAscending_Click" Text="升序" />
                            <MenuFlyoutItem Click="SortDescending_Click" Text="降序" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>

                <AppBarButton
                    x:Name="FilterButton"
                    Width="62"
                    Height="48"
                    Label="筛选器"
                    LabelPosition="Collapsed">
                    <AppBarButton.Resources>
                        <Visibility x:Key="AppBarButtonHasFlyoutChevronVisibility">Visible</Visibility>
                    </AppBarButton.Resources>
                    <AppBarButton.Icon>
                        <FontIcon
                            FontSize="16"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE71C;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="FilterMenu" Placement="Bottom">
                            <MenuFlyoutItem Click="FilterAll_Click" Text="所有媒体" />
                            <MenuFlyoutItem Click="FilterPhotos_Click" Text="照片" />
                            <MenuFlyoutItem Click="FilterVideos_Click" Text="视频" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>

                <AppBarButton
                    x:Name="LayoutButton"
                    Width="62"
                    Height="48"
                    Label="库类型和大小"
                    LabelPosition="Collapsed">
                    <AppBarButton.Resources>
                        <Visibility x:Key="AppBarButtonHasFlyoutChevronVisibility">Visible</Visibility>
                    </AppBarButton.Resources>
                    <AppBarButton.Icon>
                        <FontIcon
                            x:Name="LayoutIcon"
                            FontSize="16"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xECA5;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="LayoutMenu" Placement="Bottom">
                            <MenuFlyoutItem Click="LayoutRiver_Click" Text="等高" />
                            <MenuFlyoutItem Click="LayoutGrid_Click" Text="方形" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="SizeSmall_Click" Text="小" />
                            <MenuFlyoutItem Click="SizeMedium_Click" Text="中等" />
                            <MenuFlyoutItem Click="SizeLarge_Click" Text="大" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>

                <!--  「更多」就是 CommandBar 自带的溢出按钮（实测 48 宽）  -->
                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        x:Name="SelectAllButton"
                        Click="SelectAll_Click"
                        Label="全选">
                        <AppBarButton.Icon>
                            <FontIcon
                                FontSize="16"
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE8B3;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="SelectNoneButton"
                        Click="SelectNone_Click"
                        Label="不选择任何项目">
                        <AppBarButton.Icon>
                            <FontIcon
                                FontSize="16"
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE711;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <TextBlock
            x:Name="DateHeader"
            Grid.Row="1"
            Margin="32,0,48,10"
            FontSize="14"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis" />
        <!--  内容区：照搬 photos 的 GalleryView.xaml 两层边距
              外层 Grid = GalleryViewGridMargin 32,0,0,0（只留左）
              内层内容 = GalleryViewGridContentMargin 0,0,48,0（右留白给时间线）
              这样滚动条才能贴到窗口右边缘（见 PhotosManager/Styles/Page.xaml 的注释）  -->
        <Grid Grid.Row="2" Margin="32,0,0,0">
            <ScrollViewer
                x:Name="Scroller"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                IsTabStop="False"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Enabled"
                ZoomMode="Disabled">
                <controls:PhotoGalleryPanel x:Name="Panel" Margin="0,0,48,0" />
            </ScrollViewer>

            <controls:TimelineScrollbar x:Name="Timeline" />


            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="EmptyTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="EmptySubtitle"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxWidth="530"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
