<?xml version="1.0" encoding="utf-8"?>
<!--  单图查看器：照搬 galleryold preview.py 结构（左图 + 右详情 360px；
      内容区 margin(16,52,-16,-16)；窄窗 <900 上下分栏），
      容器与美术按 photos 规范。  -->
<Grid
    x:Class="Gallery.Controls.PreviewOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewer="using:Gallery.Controls.Viewer"
    Background="#CC000000"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    Tapped="OnBackgroundTapped"
    Visibility="Collapsed">

    <Grid x:Name="ContentArea" Margin="16,52,16,16">
        <Grid x:Name="PhotoArea" RightTapped="OnPhotoAreaRightTapped">
            <!--  飞入/飞回变换载体（galleryold：缩略图 rect → image_rect 插值，圆角 8）  -->
            <Grid
                x:Name="ImageHost"
                CornerRadius="8"
                RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="FlightTransform" />
                </Grid.RenderTransform>
                <viewer:ImageViewer x:Name="Viewer" />
            </Grid>

            <!--  翻页按钮 44×44、垂直居中、距边 12（照 galleryold）  -->
            <Button
                x:Name="PrevButton"
                Width="44"
                Height="44"
                Margin="12,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#66000000"
                BorderThickness="0"
                Click="Prev_Click"
                ToolTipService.ToolTip="上一张">
                <FontIcon FontSize="20" Foreground="White" Glyph="&#xE76B;" />
            </Button>
            <Button
                x:Name="NextButton"
                Width="44"
                Height="44"
                Margin="0,0,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="#66000000"
                BorderThickness="0"
                Click="Next_Click"
                ToolTipService.ToolTip="下一张">
                <FontIcon FontSize="20" Foreground="White" Glyph="&#xE76C;" />
            </Button>

            <!--  关闭按钮 44×44、图片区右上 (12,12)  -->
            <Button
                x:Name="CloseButton"
                Width="44"
                Height="44"
                Margin="0,12,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#66000000"
                BorderThickness="0"
                Click="Close_Click"
                ToolTipService.ToolTip="关闭">
                <FontIcon FontSize="22" Foreground="White" Glyph="&#xE711;" />
            </Button>

            <!--  底部工具条：适应 / 100% / 百分比  -->
            <StackPanel
                Margin="0,0,0,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Padding="10,6"
                    Background="#66000000"
                    BorderThickness="0"
                    Click="ZoomFit_Click"
                    Foreground="White"
                    Content="适应" />
                <Button
                    Padding="10,6"
                    Background="#66000000"
                    BorderThickness="0"
                    Click="Zoom100_Click"
                    Foreground="White"
                    Content="100%" />
                <Border
                    Padding="10,6"
                    Background="#66000000"
                    CornerRadius="4">
                    <TextBlock x:Name="ZoomText" FontSize="13" Foreground="White" Text="100%" />
                </Border>
            </StackPanel>

            <!--  「正在加载原图…」提示 (16,16)  -->
            <TextBlock
                x:Name="LoadingText"
                Margin="16,16,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="13"
                Foreground="#B3FFFFFF"
                Text="正在加载原图…"
                Visibility="Collapsed" />
        </Grid>

        <viewer:DetailPanel x:Name="Detail" />
    </Grid>
</Grid>
