<?xml version="1.0" encoding="utf-8"?>
<!--  单图查看器：照搬 galleryold preview.py 结构（左图 + 右详情 360px；
      内容区 margin(16,52,-16,-16)；窄窗 <900 上下分栏），
      容器与美术按 photos 规范。  -->
<Grid
    x:Class="Gallery.Controls.PreviewOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewer="using:Gallery.Controls.Viewer"
    xmlns:controls="using:Gallery.Controls"
    Background="#CC000000"
    IsTabStop="True"
    TabFocusNavigation="Cycle"
    KeyDown="OnKeyDown"
    Tapped="OnBackgroundTapped"
    Visibility="Collapsed">

    <Grid.Resources>
        <!--  沉浸式顶栏按钮：透明底，键盘使用原生焦点提示  -->
        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <!--  视频播放条按钮：比顶栏略大，透明底，白色图标  -->
        <Style x:Key="VideoBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Grid.Resources>

    <Grid x:Name="ContentArea" Margin="16,52,16,16">
        <Grid x:Name="PhotoArea" RightTapped="OnPhotoAreaRightTapped">
            <!--  飞入/飞回变换载体（galleryold：缩略图 rect → image_rect 插值，圆角 8）  -->
            <Grid
                x:Name="ImageHost"
                CornerRadius="8"
                RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="FlightTransform" />
                </Grid.RenderTransform>
                <viewer:ImageViewer x:Name="Viewer" />
                <viewer:VideoViewer x:Name="VideoPlayer" Visibility="Collapsed" />
            </Grid>

            <!--  全屏时左右边缘感应带：指针贴边才唤醒翻页箭头  -->
            <Border
                x:Name="LeftEdgeHost"
                Width="96"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="Transparent"
                IsHitTestVisible="False"
                PointerEntered="LeftEdgeHost_PointerEntered"
                PointerExited="LeftEdgeHost_PointerExited" />
            <Border
                x:Name="RightEdgeHost"
                Width="96"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="Transparent"
                IsHitTestVisible="False"
                PointerEntered="RightEdgeHost_PointerEntered"
                PointerExited="RightEdgeHost_PointerExited" />

            <!--  翻页按钮 44×44、垂直居中、距边 12（照 galleryold）  -->
            <Button
                x:Name="PrevButton"
                Width="44"
                Height="44"
                Margin="12,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#66000000"
                BorderThickness="0"
                Click="Prev_Click"
                ToolTipService.ToolTip="上一张">
                <FontIcon FontSize="20" Foreground="White" Glyph="&#xE76B;" />
            </Button>
            <Button
                x:Name="NextButton"
                Width="44"
                Height="44"
                Margin="0,0,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="#66000000"
                BorderThickness="0"
                Click="Next_Click"
                ToolTipService.ToolTip="下一张">
                <FontIcon FontSize="20" Foreground="White" Glyph="&#xE76C;" />
            </Button>

            <!--  关闭按钮 44×44、图片区右上 (12,12)  -->
            <Button
                x:Name="CloseButton"
                Width="44"
                Height="44"
                Margin="0,12,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#66000000"
                BorderThickness="0"
                Click="Close_Click"
                ToolTipService.ToolTip="关闭">
                <FontIcon FontSize="22" Foreground="White" Glyph="&#xE711;" />
            </Button>

            <!--  底部缩放条悬停区：鼠标悬停或键盘 Tab 进入时浮出，持有焦点时保留
                  （Photos 的证据是 ContentViewModel.PointerMoved + GetBottomBarRowHeight(fullscreen)
                  驱动底栏显隐；鼠标移出且无焦点、下拉或拖动占用时收起）  -->
            <Border
                x:Name="ZoomBarHost"
                Height="96"
                MinWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="Transparent"
                PointerEntered="ZoomBarHost_PointerEntered"
                PointerExited="ZoomBarHost_PointerExited">
                <!--  底部工具条（照 Photos 查看器样式）：适应窗口 / 实际大小 / 百分比下拉
                      / 缩小 · 滑块 · 放大 / 全屏  -->
                <Border
                    x:Name="ZoomBar"
                    Margin="0,0,0,12"
                    Padding="6,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#CC1C1C1C"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Opacity="0"
                    Visibility="Collapsed">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        AutomationProperties.Name="适应窗口"
                        x:Name="ZoomFitButton"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ZoomFit_Click"
                        Foreground="White"
                        ToolTipService.ToolTip="适应窗口">
                        <FontIcon FontSize="16" Glyph="&#xE9A6;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="实际大小"
                        x:Name="ZoomActualButton"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Zoom100_Click"
                        Foreground="White"
                        ToolTipService.ToolTip="实际大小">
                        <FontIcon
                            FontFamily="{StaticResource PhotosUWPFontFamily}"
                            FontSize="16"
                            Glyph="&#xE799;" />
                    </Button>
                    <controls:SelectionDropDown
                        x:Name="ZoomPercentBox"
                        AutomationProperties.Name="缩放比例"
                        Height="32"
                        MinWidth="92"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="#1AFFFFFF"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Foreground="White"
                        PlaceholderText="100%"
                        SelectionChanged="ZoomPercent_SelectionChanged" />
                    <Button
                        AutomationProperties.Name="缩小"
                        x:Name="ZoomOutButton"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ZoomOut_Click"
                        Foreground="White"
                        ToolTipService.ToolTip="缩小">
                        <FontIcon FontSize="16" Glyph="&#xE71F;" />
                    </Button>
                    <Slider
                        x:Name="ZoomSlider"
                        Width="180"
                        Margin="2,0"
                        VerticalAlignment="Center"
                        Maximum="400"
                        Minimum="5"
                        StepFrequency="5"
                        ValueChanged="ZoomSlider_ValueChanged" />
                    <Button
                        AutomationProperties.Name="放大"
                        x:Name="ZoomInButton"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ZoomIn_Click"
                        Foreground="White"
                        ToolTipService.ToolTip="放大">
                        <FontIcon FontSize="16" Glyph="&#xE8A3;" />
                    </Button>
                    <Border
                        Width="1"
                        Height="18"
                        Margin="4,0"
                        Background="#33FFFFFF" />
                    <Button
                        AutomationProperties.Name="全屏"
                        x:Name="FullscreenButton"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Fullscreen_Click"
                        Foreground="White"
                        ToolTipService.ToolTip="全屏">
                        <FontIcon x:Name="FullscreenIcon" FontSize="16" Glyph="&#xE740;" />
                    </Button>
                </StackPanel>
                </Border>
            </Border>

            <!--  视频播放条：左侧播放/暂停 + 下一个视频，右侧音量/设置/全屏；
                  画面比例、播放速度、投屏收进设置菜单；进度与时间保留在按钮上方。  -->
            <Border
                x:Name="VideoBar"
                Margin="12,0,12,10"
                Padding="10,7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="#CC1C1C1C"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                RightTapped="VideoBar_RightTapped"
                Visibility="Collapsed">
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Margin="4,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="VideoElapsedText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#B3FFFFFF"
                            Text="0:00"
                            TextAlignment="Right" />
                        <Slider
                            x:Name="VideoSeekSlider"
                            Grid.Column="1"
                            Height="22"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="播放进度"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.1"
                            PointerCaptureLost="VideoSeekSlider_PointerCaptureLost"
                            PointerPressed="VideoSeekSlider_PointerPressed"
                            PointerReleased="VideoSeekSlider_PointerReleased"
                            ValueChanged="VideoSeekSlider_ValueChanged" />
                        <TextBlock
                            x:Name="VideoDurationText"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#B3FFFFFF"
                            Text="0:00"
                            TextAlignment="Left" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,2,0,0">
                        <StackPanel
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button
                                x:Name="VideoPlayPauseButton"
                                AutomationProperties.Name="播放/暂停"
                                Click="VideoPlayPause_Click"
                                Style="{StaticResource VideoBarButtonStyle}"
                                ToolTipService.ToolTip="播放">
                                <FontIcon
                                    x:Name="VideoPlayPauseIcon"
                                    FontSize="18"
                                    Glyph="&#xE768;" />
                            </Button>
                            <Button
                                x:Name="VideoNextButton"
                                AutomationProperties.Name="下一个视频"
                                Click="VideoNext_Click"
                                Style="{StaticResource VideoBarButtonStyle}"
                                ToolTipService.ToolTip="下一个视频">
                                <FontIcon FontSize="18" Glyph="&#xE893;" />
                            </Button>
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button
                                x:Name="VideoVolumeButton"
                                AutomationProperties.Name="音量"
                                Style="{StaticResource VideoBarButtonStyle}"
                                ToolTipService.ToolTip="音量">
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel Width="40" Spacing="8">
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                HorizontalAlignment="Center"
                                                Text="音量" />
                                            <Slider
                                                x:Name="VideoVolumeSlider"
                                                Width="34"
                                                Height="220"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="音量"
                                                Maximum="100"
                                                Minimum="0"
                                                Orientation="Vertical"
                                                StepFrequency="1"
                                                ValueChanged="VideoVolumeSlider_ValueChanged" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                                <FontIcon
                                    x:Name="VideoVolumeIcon"
                                    FontSize="18"
                                    Glyph="&#xE767;" />
                            </Button>
                            <Button
                                x:Name="VideoSettingsButton"
                                AutomationProperties.Name="视频设置"
                                Style="{StaticResource VideoBarButtonStyle}"
                                ToolTipService.ToolTip="设置">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Top">
                                        <MenuFlyoutSubItem Text="画面比例">
                                            <RadioMenuFlyoutItem
                                                x:Name="VideoFitItem"
                                                Click="VideoFit_Click"
                                                GroupName="VideoAspect"
                                                IsChecked="True"
                                                Text="适应窗口" />
                                            <RadioMenuFlyoutItem
                                                x:Name="VideoFillItem"
                                                Click="VideoFill_Click"
                                                GroupName="VideoAspect"
                                                Text="填满窗口" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem Text="播放速度">
                                            <RadioMenuFlyoutItem
                                                Click="VideoSpeed_Click"
                                                GroupName="VideoSpeed"
                                                Tag="0.5"
                                                Text="0.5×" />
                                            <RadioMenuFlyoutItem
                                                Click="VideoSpeed_Click"
                                                GroupName="VideoSpeed"
                                                Tag="0.75"
                                                Text="0.75×" />
                                            <RadioMenuFlyoutItem
                                                Click="VideoSpeed_Click"
                                                GroupName="VideoSpeed"
                                                IsChecked="True"
                                                Tag="1"
                                                Text="1.0×" />
                                            <RadioMenuFlyoutItem
                                                Click="VideoSpeed_Click"
                                                GroupName="VideoSpeed"
                                                Tag="1.25"
                                                Text="1.25×" />
                                            <RadioMenuFlyoutItem
                                                Click="VideoSpeed_Click"
                                                GroupName="VideoSpeed"
                                                Tag="1.5"
                                                Text="1.5×" />
                                            <RadioMenuFlyoutItem
                                                Click="VideoSpeed_Click"
                                                GroupName="VideoSpeed"
                                                Tag="2"
                                                Text="2.0×" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Click="VideoCast_Click" Text="投放到设备">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEC15;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <FontIcon FontSize="18" Glyph="&#xE713;" />
                            </Button>
                            <Button
                                x:Name="VideoFullscreenButton"
                                AutomationProperties.Name="全屏"
                                Click="VideoFullscreen_Click"
                                Style="{StaticResource VideoBarButtonStyle}"
                                ToolTipService.ToolTip="全屏">
                                <FontIcon
                                    x:Name="VideoFullscreenIcon"
                                    FontSize="18"
                                    Glyph="&#xE740;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!--  全屏沉浸式顶栏：只在指针移到顶部时浮出。
                  证据：Photos ViewerRootViewModel.IsTitleBarVisible(isPointerAtTheTop, isFullScreenMode)
                  + GetTitleBarRowHeight(isFullScreenMode)，实现是原生组件不可读，布局按全屏截图还原。  -->
            <Border
                x:Name="TopBarHost"
                Height="64"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="Transparent"
                IsHitTestVisible="False"
                PointerEntered="TopBarHost_PointerEntered"
                PointerExited="TopBarHost_PointerExited">
                <Border
                    x:Name="TopBar"
                    Height="44"
                    Margin="12,8,12,0"
                    Padding="6,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="#CC1C1C1C"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Opacity="0"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button
                                AutomationProperties.Name="返回图库"
                                Click="Close_Click"
                                Style="{StaticResource TopBarButtonStyle}"
                                ToolTipService.ToolTip="返回图库">
                                <FontIcon FontSize="16" Glyph="&#xE72B;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="图片信息"
                                Click="TopInfo_Click"
                                Style="{StaticResource TopBarButtonStyle}"
                                ToolTipService.ToolTip="图片信息">
                                <FontIcon FontSize="16" Glyph="&#xE946;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="删除"
                                Click="TopDelete_Click"
                                Style="{StaticResource TopBarButtonStyle}"
                                ToolTipService.ToolTip="删除">
                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="更多"
                                x:Name="TopMoreButton"
                                Click="TopMore_Click"
                                Style="{StaticResource TopBarButtonStyle}"
                                ToolTipService.ToolTip="更多">
                                <FontIcon FontSize="16" Glyph="&#xE712;" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            x:Name="TopFileName"
                            Grid.Column="1"
                            Margin="12,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="White"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button
                                AutomationProperties.Name="最小化"
                                Click="TopMinimize_Click"
                                Style="{StaticResource TopBarButtonStyle}"
                                ToolTipService.ToolTip="最小化">
                                <FontIcon FontSize="16" Glyph="&#xE921;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="退出全屏"
                                Click="TopExitFullscreen_Click"
                                Style="{StaticResource TopBarButtonStyle}"
                                ToolTipService.ToolTip="退出全屏">
                                <FontIcon FontSize="16" Glyph="&#xE73F;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="关闭查看器"
                                Click="Close_Click"
                                Style="{StaticResource TopBarButtonStyle}"
                                ToolTipService.ToolTip="关闭">
                                <FontIcon FontSize="16" Glyph="&#xE8BB;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!--  「正在加载原图…」提示 (16,16)  -->
            <TextBlock
                x:Name="LoadingText"
                Margin="16,16,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="13"
                Foreground="#B3FFFFFF"
                Text="正在加载原图…"
                Visibility="Collapsed" />
        </Grid>

        <viewer:DetailPanel x:Name="Detail" />
    </Grid>
</Grid>
